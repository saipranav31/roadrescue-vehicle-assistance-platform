# RoadRescue Environment Configuration Template
# Copy this file to .env and set your credentials

PORT=5000

# MSG91 OTP Widget Configuration
MSG91_WIDGET_ID=your_msg91_widget_id_here
MSG91_TOKEN_AUTH=your_msg91_token_auth_here

# Optional Alternative Provider Keys
FAST2SMS_API_KEY=your_fast2sms_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
